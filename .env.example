# ---- backend ----
DATABASE_URL=postgresql://meetingpnt:meetingpnt@localhost:5432/meetingpnt
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Optional. Only needed to fan Socket.IO events across multiple backend instances; leave unset
# when running a single instance (which is what the free-tier deployment does).
REDIS_URL=redis://localhost:6379
GOOGLE_MAPS_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
PORTAL_URL=http://localhost:5173
MOBILE_DEEP_LINK_SCHEME=meetingpnt
PORT=4000
BACKEND_PUBLIC_URL=http://localhost:4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

# ---- portal (Vite: must be prefixed VITE_) ----
VITE_API_BASE_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
VITE_GOOGLE_MAPS_API_KEY=

# ---- mobile (Expo: must be prefixed EXPO_PUBLIC_) ----
# Deployed builds get these from mobile/eas.json, not from this file.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
