{
  "expo": {
    "name": "MeetingPnt",
    "slug": "meetingpnt",
    "scheme": "meetingpnt",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meetingpnt.app"
    },
    "android": {
      "package": "com.meetingpnt.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MeetingPnt uses your location only when you tap \"On My Way\" or respond to a leader's location request — never in the background."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
