{
  "expo": {
    "name": "MeetingPnt",
    "slug": "meetingpnt",
    "scheme": "meetingpnt",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2563eb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.meetingpnt.app"
    },
    "android": {
      "package": "com.meetingpnt.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563eb"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#2563eb"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MeetingPnt uses your location when you tap \"On My Way\", respond to a location request, or share your live position as a leader — only while the app is open, never in the background."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e68e7c42-2254-4870-818c-4b8c9cc20ada"
      }
    },
    "owner": "meetingpnt"
  }
}
