generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, citext]
}

enum UserRole {
  admin
  leader
  user
}

enum GroupStatus {
  planned
  in_progress
  completed
}

enum GroupMemberStatus {
  active
  removed
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum ActivityStatus {
  draft
  published
  in_progress
  completed
  cancelled
}

enum TransportMode {
  driving
  walking
  bicycling
  transit
}

enum RsvpStatus {
  pending
  approved
  declined
}

enum LocationSource {
  omw
  ping_response
  /// A fix from the leader's live "follow me" broadcast. Carries no ETA — the leader isn't
  /// travelling to the meeting point, they're the thing everyone else is heading towards.
  leader_broadcast
}

enum AttendanceStatus {
  present
  absent
}

enum GroupChatMode {
  announcements
  two_way
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  role         UserRole @default(user)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens         RefreshToken[]
  pushTokens            PushToken[]
  auditLogsAsActor      AuditLog[]         @relation("AuditActor")
  auditLogsAsTarget     AuditLog[]         @relation("AuditTarget")
  groupsLed             Group[]            @relation("GroupLeader")
  groupMemberships      GroupMember[]
  invitationsSent       Invitation[]
  activitiesCreated     Activity[]
  rsvps                 Rsvp[]
  meetingPointsCreated  MeetingPoint[]
  locationSnapshots     LocationSnapshot[]
  activityGuestOf       ActivityGuest[]    @relation("ActivityGuestUser")
  activityGuestsInvited ActivityGuest[]    @relation("ActivityGuestInviter")
  attendanceRecords     Attendance[]       @relation("AttendanceUser")
  attendanceMarked      Attendance[]       @relation("AttendanceMarker")
  messages              Message[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PushToken {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  expoPushToken String   @map("expo_push_token")
  platform      String
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, expoPushToken])
  @@map("push_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String   @map("actor_id")
  targetId  String   @map("target_id")
  action    String
  fromValue String?  @map("from_value")
  toValue   String?  @map("to_value")
  createdAt DateTime @default(now()) @map("created_at")

  actor  User @relation("AuditActor", fields: [actorId], references: [id])
  target User @relation("AuditTarget", fields: [targetId], references: [id])

  @@map("audit_log")
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  status      GroupStatus   @default(planned)
  chatMode    GroupChatMode @default(two_way) @map("chat_mode")
  leaderId    String        @map("leader_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  leader        User           @relation("GroupLeader", fields: [leaderId], references: [id])
  members       GroupMember[]
  invitations   Invitation[]
  activities    Activity[]
  meetingPoints MeetingPoint[]
  messages      Message[]

  @@index([leaderId])
  @@map("groups")
}

model GroupMember {
  id       String            @id @default(uuid())
  groupId  String            @map("group_id")
  userId   String            @map("user_id")
  status   GroupMemberStatus @default(active)
  joinedAt DateTime          @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId, status])
  @@index([userId])
  @@map("group_members")
}

model Invitation {
  id         String           @id @default(uuid())
  groupId    String           @map("group_id")
  activityId String?          @map("activity_id")
  email      String           @db.Citext
  firstName  String?          @map("first_name")
  lastName   String?          @map("last_name")
  phone      String?
  tokenHash  String           @map("token_hash")
  status     InvitationStatus @default(pending)
  invitedBy  String           @map("invited_by")
  expiresAt  DateTime         @map("expires_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id], onDelete: Cascade)
  inviter  User      @relation(fields: [invitedBy], references: [id])

  @@unique([tokenHash])
  @@index([groupId, email])
  @@map("invitations")
}

model Activity {
  id            String         @id @default(uuid())
  groupId       String         @map("group_id")
  seriesId      String?        @map("series_id")
  title         String
  description   String?
  startAt       DateTime       @map("start_at")
  endAt         DateTime       @map("end_at")
  // Multi-day/date-only activity: clock times aren't meaningful and are hidden in the UI.
  allDay        Boolean        @default(false) @map("all_day")
  transportMode TransportMode  @default(driving) @map("transport_mode")
  requiresRsvp  Boolean        @default(true) @map("requires_rsvp")
  // One place, no route: a yoga class in the same room every week. The clients show a single
  // meeting point and no way to add a second. Stored rather than inferred from having one stop,
  // since a walk mid-planning also has one and must keep its "add stop" button.
  singleLocation Boolean       @default(false) @map("single_location")
  status        ActivityStatus @default(draft)
  // Where the group is right now — the stop the apps show and the ETA is measured to. Deliberately
  // a stored pointer rather than "the newest meeting point": once the leader plans the whole
  // itinerary up front, the newest point is the *last* stop, not the current one. Left as a plain
  // column rather than a Prisma relation to avoid a cascade cycle with MeetingPoint.activityId;
  // the FK and its ON DELETE SET NULL live in the migration.
  currentMeetingPointId String?  @map("current_meeting_point_id")
  // "Follow me" — until when the leader is sharing a live position. A lease rather than a flag, so
  // a force-quit app or a dead battery can't leave the channel open indefinitely; null means not
  // broadcasting, and a time in the past means the lease lapsed. Capped at the activity's end.
  leaderBroadcastUntil  DateTime? @map("leader_broadcast_until")
  createdBy     String         @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  group             Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator           User               @relation(fields: [createdBy], references: [id])
  rsvps             Rsvp[]
  meetingPoints     MeetingPoint[]
  locationSnapshots LocationSnapshot[]
  invitations       Invitation[]
  guests            ActivityGuest[]

  @@index([groupId, startAt])
  @@index([seriesId])
  @@map("activities")
}

// Scoped to a meeting point rather than an activity: a group that moves between sites needs
// a separate roll call at each one. Activity-level participation is derived in the service.
model Attendance {
  id             String           @id @default(uuid())
  meetingPointId String           @map("meeting_point_id")
  userId         String           @map("user_id")
  status         AttendanceStatus
  markedBy       String           @map("marked_by")
  markedAt       DateTime         @default(now()) @map("marked_at")

  meetingPoint MeetingPoint @relation(fields: [meetingPointId], references: [id], onDelete: Cascade)
  user         User         @relation("AttendanceUser", fields: [userId], references: [id], onDelete: Cascade)
  marker       User         @relation("AttendanceMarker", fields: [markedBy], references: [id])

  @@unique([meetingPointId, userId])
  @@index([meetingPointId])
  @@map("attendance")
}

model Message {
  id        String   @id @default(uuid())
  groupId   String   @map("group_id")
  authorId  String   @map("author_id")
  body      String?
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id])

  @@index([groupId, createdAt])
  @@map("messages")
}

model ActivityGuest {
  id         String   @id @default(uuid())
  activityId String   @map("activity_id")
  userId     String   @map("user_id")
  invitedBy  String   @map("invited_by")
  createdAt  DateTime @default(now()) @map("created_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation("ActivityGuestUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter  User     @relation("ActivityGuestInviter", fields: [invitedBy], references: [id])

  @@unique([activityId, userId])
  @@index([userId])
  @@map("activity_guests")
}

model Rsvp {
  id          String     @id @default(uuid())
  activityId  String     @map("activity_id")
  userId      String     @map("user_id")
  status      RsvpStatus @default(pending)
  note        String?
  respondedAt DateTime?  @map("responded_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@index([activityId, status])
  @@map("rsvps")
}

// location is managed exclusively via raw SQL ($queryRaw/$executeRaw) since Prisma
// Client can't read/write Unsupported columns — see modules/*/repo.ts.
model MeetingPoint {
  id            String                               @id @default(uuid())
  groupId       String                               @map("group_id")
  activityId    String?                              @map("activity_id")
  label         String?
  googleMapsUrl String                               @map("google_maps_url")
  location      Unsupported("geography(Point,4326)")
  time          DateTime
  // Null until the group actually gets here. The leader plans the itinerary up front, so the
  // list of points and the group's progress through it are two different things: creation order
  // is the planned route, arrivedAt is the trail of stops actually visited. Where the group is
  // *now* is Activity.currentMeetingPointId, not the newest of these.
  arrivedAt     DateTime?                            @map("arrived_at")
  createdBy     String                               @map("created_by")
  createdAt     DateTime                             @default(now()) @map("created_at")

  group             Group              @relation(fields: [groupId], references: [id], onDelete: Cascade)
  activity          Activity?          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  creator           User               @relation(fields: [createdBy], references: [id])
  locationSnapshots LocationSnapshot[]
  attendance        Attendance[]

  @@index([activityId, time])
  @@map("meeting_points")
}

model LocationSnapshot {
  id             String                               @id @default(uuid())
  activityId     String                               @map("activity_id")
  userId         String                               @map("user_id")
  meetingPointId String?                              @map("meeting_point_id")
  location       Unsupported("geography(Point,4326)")
  capturedAt     DateTime                             @map("captured_at")
  etaSeconds     Int?                                 @map("eta_seconds")
  etaComputedAt  DateTime?                            @map("eta_computed_at")
  source         LocationSource
  createdAt      DateTime                             @default(now()) @map("created_at")

  activity     Activity      @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetingPoint MeetingPoint? @relation(fields: [meetingPointId], references: [id])

  @@index([activityId, userId, createdAt(sort: Desc)])
  @@map("location_snapshots")
}
